# ORCA environment (19_ENVIRONMENT_AND_CONFIGURATION_SPEC.md).
# Copy to .env and fill in. NEVER commit .env.
#
# ORCA runs with NONE of these set. Without a model it plans deterministically
# and answers from a template; without credentials the affected capabilities are
# reported as explicit gaps. Configuration adds fluency and reach, never a
# number and never a verdict.

# ---- model provider (section 3.3) -----------------------------------------
# Provider is CONFIGURATION: no provider name is hard-coded in the reasoning
# layer. Leave unset to run fully deterministically.
ORCA_LLM_PROVIDER=CHANGE_ME
ORCA_LLM_API_KEY=CHANGE_ME
ORCA_LLM_MODEL_PLANNER=CHANGE_ME
# ORCA_LLM_MODEL_FAST=
# ORCA_LLM_TEMPERATURE=0
# ORCA_LLM_TIMEOUT_S=30
# ORCA_LLM_MAX_RETRIES=2
# ORCA_LLM_BASE_URL=

# ---- data sources ----------------------------------------------------------
# CMEMS: forecast products (waves, currents) serve unauthenticated reads today;
# the observation products (SST, chlorophyll, wind) do not reliably. See
# 03_DATA_SOURCE_MATRIX.md section 15.5.
# CMEMS_USERNAME=
# CMEMS_PASSWORD=

# IMD: blocks official warnings, lightning, cyclone tracks -- and therefore any
# SAFETY verdict. This is the critical path.
# IMD_API_KEY=

# MOSDAC (P1 enhancement only)
# MOSDAC_USERNAME=
# MOSDAC_PASSWORD=
